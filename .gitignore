.env.bak-*
# captured permission cmds can contain the API token
.claude/settings.local.json

# personal / medical data dropped into the folder (not part of the app)
document*.pdf
*blood*
*.pdf

# copyrighted reference material (John Davis articles/book) — local research only, NEVER commit/mirror
JDavis/

# locally-owned data copy (your training history)
*.db
*.db-shm
*.db-wal
*.db-journal
data/
# private-only key store (Runalyze token / Claude key set in the Settings window)
secrets/

