# Copy this to .env (which is git-ignored) and fill in real values.
# Never commit the real .env, and never paste tokens into chats/screenshots.
RUNALYZE_TOKEN=your_runalyze_personal_api_token

# LLM adjustment layer (§6c) — optional; blank keeps the AI features dormant.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Nightly auto-sync on the private/writable instance (defaults shown):
# SH_TZ=UTC            # your IANA timezone for the sync hour, e.g. Europe/Lisbon, America/New_York
# SH_SYNC_AT=22:00     # local time (in SH_TZ) to pull the day's activities
# SH_SCHEDULE=0        # disable the nightly pull entirely

# Optional personalization (all blank by default):
# SH_SEED_OBJECTIVE=Berlin Marathon|2026-09-27|marathon|finish|A   # seed a first race (label|date|type|target|priority)
# SH_ATHLETE_CONTEXT=masters runner returning from injury, cleared by my doctor   # one line, injected into the LLM prompts
# SH_HOUSE_URL=https://example.com                                  # optional back-link in the header
# SH_HOUSE_NAME=home                                                # label for that link (defaults to the URL)

# Public read-only container only (set in docker-compose, not here):
# SH_READONLY=1        # blocks all writes + withholds medical sections; no tokens on that container

# §AUTH (0.56.0) — the private console locks itself. Leave these unset to set the passphrase in the
# browser on first boot; set SH_PASSPHRASE to skip that page. See DEPLOY.md §2.
# SH_PASSPHRASE=a long passphrase of at least twelve characters
# SH_SECRET_KEY=a long random string       # encrypts the secrets store; keeps the key off the volume
# SH_TRUST_PROXY_AUTH=1                     # skip the login for a VERIFIED proxy identity …
# SH_CF_ACCESS_TEAM=yourteam                # … a Cloudflare Access JWT (team name or team.cloudflareaccess.com)
# SH_CF_ACCESS_AUD=…the application's audience tag (prepare_env.sh --from-container reads it)…
# SH_PROXY_CIDR=172.18.0.0/16               # … or X-Forwarded-User from a proxy inside this network
# SH_COOKIE_SECURE=0                        # plain-http LAN box only; the session cookie is Secure by default
# SH_AI_NARRATION=1 / SH_AI_PARSING=1 / SH_AI_JUDGMENT=0   # the AI switches' env fallbacks (Settings overrides)

# Backups (0.56.1) — the private box writes a snapshot to ./backups after each successful nightly.
# SH_BACKUP_KEEP=7                          # how many nightlies to keep
# SH_BACKUP_PUSH=cp "$SH_BACKUP_FILE" /mnt/offsite/   # runs INSIDE the container after each snapshot (python + sh only)
